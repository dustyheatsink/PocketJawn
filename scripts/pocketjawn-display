#!/usr/bin/env python3
# Sleeps display after inactivity, wakes on button press
import select
import subprocess
import time
from evdev import InputDevice, list_devices, ecodes

TIMEOUT = 120

def display(on):
    subprocess.run(
        ["vcgencmd", "display_power", "1" if on else "0"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL
    )

devices = []
for path in list_devices():
    dev = InputDevice(path)
    if dev.name.startswith("pocketTerm35 pocketTerm35"):
        devices.append(dev)

if not devices:
    raise SystemExit("PocketTerm35 input devices not found")

last_activity = time.monotonic()
screen_on = True

while True:
    ready, _, _ = select.select(devices, [], [], 1)

    if ready:
        activity = False

        for dev in ready:
            for event in dev.read():
                if event.type in (ecodes.EV_KEY, ecodes.EV_REL, ecodes.EV_ABS):
                    activity = True

        if activity:
            last_activity = time.monotonic()

            if not screen_on:
                display(True)
                screen_on = True

    elif screen_on and time.monotonic() - last_activity >= TIMEOUT:
        display(False)
        screen_on = False
